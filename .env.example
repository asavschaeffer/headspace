# Reference only: Headspace 0.1.0 does not automatically load this file.
HEADSPACE_WORKSPACE=C:\path\to\workspace
HEADSPACE_HOST=127.0.0.1
HEADSPACE_PORT=4173
HEADSPACE_DIST=dist

# Optional OpenAI Responses collaborator (set both).
OPENAI_API_KEY=
HEADSPACE_OPENAI_MODEL=

# Optional PDF-to-Markdown HTTP converter.
HEADSPACE_PDF_CONVERTER_URL=
HEADSPACE_PDF_CONVERTER_SERVICE_IDENTITY=
HEADSPACE_PDF_CONVERTER_IMPLEMENTATION_VERSION=
HEADSPACE_PDF_CONVERTER_TOKEN=
HEADSPACE_PDF_CONVERTER_TIMEOUT_MS=30000
HEADSPACE_PDF_CONVERTER_MAX_RESPONSE_BYTES=8388608
