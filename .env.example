# Server
PORT=3000
DATA_DIR=.headspace

# Cortex limits
CORTEX_MAX_BYTES=1048576
PROVIDER_TIMEOUT_SECS=20

# Provider fallback order (cloud-first)
PROVIDER_ORDER=nvidia,vertex,openrouter,vllm

# Local provider (disabled by default)
ENABLE_LOCAL=false
LOCAL_PROVIDER=vllm
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# NVIDIA (multimodal/summaries)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Embeddings (defaults to NVIDIA_API_KEY if EMBEDDING_API_KEY is unset)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_BATCH_SIZE=50
EMBEDDING_BATCH_DELAY_MS=100
EMBEDDING_TRUNCATE_CHARS=2000

# Vertex AI (OpenAI-compatible endpoint)
VERTEX_CHAT_URL=
VERTEX_API_KEY=
VERTEX_MODEL=gemini-2.5-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Status classification thresholds
STATUS_DRAFT_DAYS=14
STATUS_ACTIVE_DAYS=30
STATUS_ROT_DAYS=365
STATUS_ACTIVE_MIN_BYTES=2048
STATUS_ROT_MAX_BYTES=8192
