# AI-OS Configuration Template
# Copy this file to .env and fill in your values.

# LLM Provider Selection
# Options: gemini, anthropic, local, mock
AIOS_LLM_PROVIDER=local

# Embedding Provider Selection (Optional)
# Options: gemini, local, mock
# AIOS_EMBEDDING_PROVIDER=local

# API Keys (Required if using respective provider)
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Local LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
