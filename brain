#!/usr/bin/env python3
"""
Brain CLI - Command line interface for quick thought capture

Usage:
    brain                      # Start web interface
    brain "thought text"       # Save a thought
    brain /search_term         # Search thoughts
    brain --recent             # Show recent thoughts
    brain --help               # Show this help
"""

import sys
import os
from pathlib import Path

# Add current directory to path for imports
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from brain_core import Brain

def main():
    brain = Brain()

    if len(sys.argv) == 1:
        # No arguments - start web interface
        from start_brain import main as start_server
        start_server()

    elif len(sys.argv) == 2:
        arg = sys.argv[1]

        if arg in ['-h', '--help']:
            print(__doc__)

        elif arg == '--recent':
            # Show recent thoughts
            recent = brain.search_by_time(24)
            if recent:
                print("Recent thoughts (last 24 hours):\n")
                for file in recent[:20]:
                    # Get preview
                    preview = file.read_text()[:80].replace('\n', ' ')
                    print(f"• {file.name}")
                    print(f"  {preview}...\n")
            else:
                print("No recent thoughts")

        elif arg.startswith('/') or arg.startswith('\\'):
            # Search mode (handle both forward and backslash)
            query = arg[1:] if arg[0] in '/\\' else arg
            if not query:
                print("Search query cannot be empty")
                return
            print(f"Searching for: {query}\n")

            # Search filenames
            files = brain.search_filename(query)
            if files:
                print("Filename matches:")
                for file in files[:5]:
                    print(f"  • {file.name}")
                print()

            # Search content
            results = brain.search_content(query)
            if results:
                print("Content matches:")
                for file, snippet in results[:10]:
                    print(f"  • {file.name}")
                    print(f"    {snippet}\n")
            else:
                print("No matches found")

        else:
            # Save thought
            filepath, appended = brain.save_text(arg)
            if appended:
                print(f"Appended to: {filepath.name}")
            else:
                print(f"Saved as: {filepath.name}")

    else:
        # Multiple arguments - join as single thought
        thought = ' '.join(sys.argv[1:])
        filepath, appended = brain.save_text(thought)
        if appended:
            print(f"Appended to: {filepath.name}")
        else:
            print(f"Saved as: {filepath.name}")

if __name__ == "__main__":
    main()